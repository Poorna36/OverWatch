# OverWatch (MCP Pocket Computer) Environment Variables
# Placeholder values only - DO NOT commit real secrets or production keys.

# Mobile App <-> Control Plane Static Bearer Token
APP_TOKEN=replace_with_app_bearer_token

# Vault encryption key for credentials stored at rest
VAULT_KEY=replace_with_32_byte_base64_vault_key

# Dedicated encryption key for device push tokens (32-byte base64, separate from VAULT_KEY)
PUSH_TOKEN_KEY=replace_with_32_byte_base64_push_token_key
# Optional override for Expo Push API endpoint:
# EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send

# LLM Provider API Key & Model (e.g., Anthropic, OpenAI, or Google)
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_llm_model

# Control Plane Server Settings
HOST=0.0.0.0
PORT=8000
# External HTTP/HTTPS base URL used to construct WebSocket stream URLs (http->ws, https->wss)
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database URL (SQLite persistent storage)
# In Docker Compose, data is stored in named volume overwatch-data mounted at /app/data:
# DATABASE_URL=sqlite:////app/data/overwatch.db
# For local development:
DATABASE_URL=sqlite:///./overwatch.db

# Egress Proxy URL
EGRESS_PROXY_URL=http://localhost:3128

# ---------------------------------------------------------------------------
# Docker Engine connection (control plane -> Docker daemon)
#
# The control plane connects to a Docker daemon to create and destroy session
# containers. /var/run/docker.sock is NEVER mounted into the control-plane
# container, and the default docker-compose.yml sets no DOCKER_HOST and mounts
# no TLS certificates.
#
# Host-local development (uvicorn running directly on the Docker host):
#   Leave all DOCKER_* variables unset (commented out below). The Docker SDK
#   uses the host's normal local Docker configuration automatically.
#
# Containerised Compose deployment with remote TLS (opt-in override):
#   Use: docker compose -f docker-compose.yml -f docker-compose.tls.yml up -d
#   docker-compose.tls.yml pins DOCKER_TLS_VERIFY=1, sets
#   DOCKER_CERT_PATH=/etc/overwatch/docker-tls, and requires you to supply both
#   DOCKER_HOST and DOCKER_TLS_CERT_DIR (it fails closed if either is unset).
#
#   DOCKER_HOST          - required remote TLS endpoint, e.g. tcp://replace-with-docker-host:2376
#   DOCKER_TLS_VERIFY    - set to "1" when using a tcp:// endpoint directly on a host
#   DOCKER_CERT_PATH     - cert dir path for host-run TLS; fixed to /etc/overwatch/docker-tls in docker-compose.tls.yml
#   DOCKER_TLS_CERT_DIR  - required host cert directory (ca.pem, cert.pem, key.pem) mounted :ro
#
# Operator security requirement:
#   A mutual-TLS client certificate can grant broad daemon authority, and TLS
#   alone does not provide least privilege. Use a dedicated isolated Docker host
#   or a suitable authorization layer in front of the remote daemon.
#
# Placeholders only — never commit real certificates or private keys:
# DOCKER_HOST=tcp://replace-with-docker-host:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/docker/tls/certs
# DOCKER_TLS_CERT_DIR=/path/to/docker/tls/certs
# ---------------------------------------------------------------------------
