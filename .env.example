# OverWatch (MCP Pocket Computer) Environment Variables
# Placeholder values only - DO NOT commit real secrets or production keys.

# Mobile App <-> Control Plane Static Bearer Token
APP_TOKEN=replace_with_app_bearer_token

# Vault encryption key for credentials stored at rest
VAULT_KEY=replace_with_32_byte_base64_vault_key

# LLM Provider API Key & Model (e.g., Anthropic, OpenAI, or Google)
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_llm_model

# Control Plane Server Settings
HOST=0.0.0.0
PORT=8000
# External HTTP/HTTPS base URL used to construct WebSocket stream URLs (http->ws, https->wss)
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database URL (SQLite persistent storage)
# In Docker Compose, data is stored in named volume overwatch-data mounted at /app/data:
# DATABASE_URL=sqlite:////app/data/overwatch.db
# For local development:
DATABASE_URL=sqlite:///./overwatch.db

# Egress Proxy URL
EGRESS_PROXY_URL=http://localhost:3128

# ---------------------------------------------------------------------------
# Docker Engine connection (control plane -> Docker daemon)
#
# The control plane must connect to a Docker daemon to create and destroy
# session containers.  The docker.sock is NEVER mounted into the control-plane
# container; a remotely configured endpoint is required when running in Compose.
#
# Host-local development (control plane runs directly on the Docker host):
#   Leave all DOCKER_* variables unset.  The Docker SDK reads the host socket
#   automatically.
#
# Containerised / remote deployment (control plane runs in Docker Compose or
# on a separate host):
#   Set DOCKER_HOST to a TLS-secured TCP endpoint.  Plain tcp:// endpoints are
#   rejected; unauthenticated access is never permitted.
#
#   DOCKER_HOST        – remote endpoint, e.g. tcp://10.0.0.1:2376
#   DOCKER_TLS_VERIFY  – must be "1" when DOCKER_HOST is a tcp:// URL
#   DOCKER_CERT_PATH   – directory containing ca.pem, cert.pem, and key.pem
#
# Example (replace with real paths and address; never commit certificates):
# DOCKER_HOST=tcp://replace_with_docker_host_ip:2376
# DOCKER_TLS_VERIFY=1
# DOCKER_CERT_PATH=/path/to/docker/tls/certs
# ---------------------------------------------------------------------------
